[Unit]
Description=Study Agent
After=network-online.target copilot-lan-bridge.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/bash %h/copilot-lan-bridge/study-agent/start.sh
WorkingDirectory=%h/copilot-lan-bridge/study-agent
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
